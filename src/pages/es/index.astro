---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import SeriesTile from "../../components/SeriesTile.astro";
import { getDictionary } from "../../i18n/index";

const series = (await getCollection("series")).sort((a, b) => a.data.order - b.data.order);
const dict = getDictionary("es");
---

<SiteLayout title={dict.meta.homeTitle} description={dict.meta.homeDescription} locale="es" alternatePath="/">
  <section class="home-intro" aria-label={dict.contact.areaTitle}>
    <h1>{dict.home.eyebrow}</h1>
  </section>
  <section class="home-grid" aria-label={dict.common.selectedWork}>
    {series.map((project, index) => <SeriesTile series={project} locale="es" priority={index === 0} />)}
  </section>
</SiteLayout>