---
import { getCollection } from "astro:content";
import { getDictionary, type Locale } from "../i18n/index";
import SiteLayout from "../layouts/SiteLayout.astro";
import SeriesTile from "./SeriesTile.astro";
import PortfolioNav from "./PortfolioNav.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = getDictionary(locale);
const series = (await getCollection("series")).sort((a, b) => a.data.order - b.data.order);
const alternatePath = locale === "es" ? "/portfolio/" : "/es/portfolio/";
---

<SiteLayout title={`${dict.portfolio.title} | ${dict.meta.titleSuffix}`} description={dict.portfolio.description} locale={locale} alternatePath={alternatePath}>
  <section class="page-intro portfolio-intro">
    <p class="eyebrow">Juan Serrano Studio</p>
    <h1>{dict.portfolio.title}</h1>
    <p>{dict.portfolio.lead}</p>
  </section>
  <PortfolioNav locale={locale} />
  <section class="home-grid portfolio-grid" aria-label={dict.common.selectedWork}>
    {series.map((project, index) => <SeriesTile series={project} locale={locale} priority={index === 0} />)}
  </section>
  <p class="demo-note">{dict.portfolio.demoNote}</p>
</SiteLayout>