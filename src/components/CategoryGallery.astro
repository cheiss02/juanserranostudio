---
import { getCollection } from "astro:content";
import { getDictionary, type CategorySlug, type Locale } from "../i18n/index";
import SiteLayout from "../layouts/SiteLayout.astro";
import SeriesTile from "./SeriesTile.astro";
import PortfolioNav from "./PortfolioNav.astro";

interface Props { locale: Locale; category: CategorySlug; }
const { locale, category } = Astro.props;
const dict = getDictionary(locale);
const categoryData = dict.categories[category];
const series = (await getCollection("series", (entry) => entry.data.category === category)).sort((a, b) => a.data.order - b.data.order);
const prefix = locale === "es" ? "/es" : "";
const alternatePath = locale === "es" ? `/portfolio/${category}/` : `/es/portfolio/${category}/`;
const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: categoryData.title,
  description: categoryData.description,
  url: `${Astro.site}${Astro.url.pathname}`,
  image: `${Astro.site}share-image.jpg`,
};
---

<SiteLayout title={`${categoryData.title} Photographer in Southern California | ${dict.meta.titleSuffix}`} description={categoryData.description} locale={locale} alternatePath={alternatePath} structuredData={gallerySchema}>
  <section class="page-intro category-intro">
    <a class="back-link" href={`${prefix}/portfolio/`}>{dict.common.backToPortfolio}</a>
    <p class="eyebrow">Juan Serrano Studio / {dict.portfolio.title}</p>
    <h1>{categoryData.title}</h1>
    <p>{categoryData.intro}</p>
    <a class="text-cta" href={`${prefix}/contact/`}>{dict.common.requestQuote}</a>
  </section>
  <PortfolioNav locale={locale} activeCategory={category} />
  <section class="home-grid portfolio-grid" aria-label={categoryData.title}>
    {series.map((project, index) => <SeriesTile series={project} locale={locale} priority={index === 0} />)}
  </section>
</SiteLayout>