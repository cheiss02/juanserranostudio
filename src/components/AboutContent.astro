---
import { getEntry } from "astro:content";
import { Picture } from "astro:assets";
import { getDictionary, type Locale } from "../i18n/index";
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = getDictionary(locale);
const portraitSeries = await getEntry("series", "quiet-light");
const alternatePath = locale === "es" ? "/about/" : "/es/about/";
---

<SiteLayout title={`${dict.about.title} | ${dict.meta.titleSuffix}`} description={dict.about.description} locale={locale} alternatePath={alternatePath}>
  <section class="about-layout">
    <div class="about-copy">
      <p class="eyebrow">Juan Serrano Studio</p>
      <h1>{dict.about.title}</h1>
      <p class="about-lead">{dict.about.lead}</p>
      {dict.about.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {portraitSeries && <figure class="about-portrait">
      <Picture src={portraitSeries.data.hover_image} alt={locale === "es" ? "Retrato temporal de muestra; no es Juan Serrano." : "Temporary stock portrait placeholder; this is not Juan Serrano."} formats={["avif", "webp"]} widths={[480, 800]} sizes="(min-width: 900px) 38vw, 100vw" />
      <figcaption>{dict.about.portraitNote}</figcaption>
    </figure>}
  </section>
  <section class="approach-section">
    <h2>{dict.about.approachTitle}</h2>
    <ul>{dict.about.approach.map((item) => <li>{item}</li>)}</ul>
  </section>
  <section class="clients-section">
    <h2>{dict.about.clientsTitle}</h2>
    <p>{dict.about.clientsNote}</p>
  </section>
</SiteLayout>