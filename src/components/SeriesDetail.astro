---
import { getCollection, type CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import { getDictionary, type Locale } from "../i18n/index";
import { site } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props { locale: Locale; series: CollectionEntry<"series">; }
const { locale, series } = Astro.props;
const dict = getDictionary(locale);
const category = dict.categories[series.data.category];
const title = locale === "es" ? series.data.title_es : series.data.title_en;
const description = locale === "es" ? series.data.description_es : series.data.description_en;
const allInCategory = (await getCollection("series", (entry) => entry.data.category === series.data.category)).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allInCategory.findIndex((entry) => entry.id === series.id);
const previous = allInCategory[(currentIndex - 1 + allInCategory.length) % allInCategory.length] ?? series;
const next = allInCategory[(currentIndex + 1) % allInCategory.length] ?? series;
const prefix = locale === "es" ? "/es" : "";
const alternatePath = locale === "es" ? `/portfolio/${series.data.category}/${series.id}/` : `/es/portfolio/${series.data.category}/${series.id}/`;
const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: title,
  description,
  url: `${Astro.site}${Astro.url.pathname}`,
  image: `${site.url}/share-image.jpg`,
};
const pictureProps = { formats: ["avif", "webp"], widths: [640, 1080, 1600], sizes: "100vw" };
---

<SiteLayout title={`${title} | ${category.title} Photographer in Southern California | ${dict.meta.titleSuffix}`} description={description} locale={locale} alternatePath={alternatePath} structuredData={gallerySchema}>
  <header class="series-heading">
    <a class="back-link" href={`${prefix}/portfolio/${series.data.category}/`}>{category.title}</a>
    <p class="eyebrow">{site.name} / {category.title}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </header>
  <section class="series-images" aria-label={dict.portfolio.series}>
    {series.data.images.map((photo, index) => <figure class="series-photo">
      <Picture src={photo.src} alt={locale === "es" ? photo.alt_es : photo.alt_en} {...pictureProps} loading={index === 0 ? "eager" : "lazy"} />
    </figure>)}
  </section>
  <nav class="series-pager" aria-label={dict.portfolio.series}>
    <a href={`${prefix}/portfolio/${series.data.category}/${previous.id}/`}><span>{dict.common.previous}</span><strong>{locale === "es" ? previous.data.title_es : previous.data.title_en}</strong></a>
    <a href={`${prefix}/portfolio/${series.data.category}/${next.id}/`}><span>{dict.common.next}</span><strong>{locale === "es" ? next.data.title_es : next.data.title_en}</strong></a>
  </nav>
</SiteLayout>